[Unit]
Description=HOAG research discovery dashboard
After=network.target

[Service]
User=hoag-indexer
Group=hoag-indexer
UMask=0077
ExecStart=/opt/hoag-research/venv/bin/python /opt/hoag-research/pipeline.py dashboard --db /var/lib/hoag-research/catalog.sqlite
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/var/lib/hoag-research

[Install]
WantedBy=multi-user.target
