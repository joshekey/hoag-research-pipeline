[Unit]
Description=HOAG research processing worker
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
User=hoag-indexer
Group=hoag-indexer
UMask=0077
WorkingDirectory=/opt/hoag-research
ExecStart=/opt/hoag-research/venv/bin/python /opt/hoag-research/manage.py worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
MemoryMax=6G

[Install]
WantedBy=multi-user.target
