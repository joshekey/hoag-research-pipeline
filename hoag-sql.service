[Unit]
Description=HOAG read-only SQL report candidate broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/hoag-research
ExecStart=/opt/hoag-research/venv/bin/python /opt/hoag-research/sql_broker.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RuntimeDirectory=hoag-sql
RuntimeDirectoryMode=0750
MemoryMax=256M
ReadOnlyPaths=/var/lib/hoag-research/sql-private /etc/hoag-research
ReadWritePaths=/run/hoag-sql

[Install]
WantedBy=multi-user.target
